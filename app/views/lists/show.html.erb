<div class="container mt-4">
  <h1><%= @list.name %></h1>

  <div class="row">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-12 col-md-6 col-lg-4 mb-4">
        <div class="card-trip">
          <%= image_tag bookmark.movie.poster_url %>

          <div class="card-trip-infos">
            <h2>
              <%= bookmark.movie.title %>
              • <%= bookmark.movie.rating %>
            </h2>

            <p><%= bookmark.movie.overview %></p>

            <p>
              <strong>Comment:</strong>
              <%= bookmark.comment %>
            </p>

            <%= link_to "Delete",
                        bookmark_path(bookmark),
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Are you sure?"
                        },
                        class: "text-danger" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <h2 class="mt-4">Add a movie</h2>

  <%= simple_form_for [@list, Bookmark.new] do |f| %>
    <%= f.association :movie,
                      collection: Movie.all,
                      label_method: :title,
                      value_method: :id %>

    <%= f.input :comment %>

    <%= f.submit "Add Movie", class: "btn btn-primary" %>
  <% end %>

  <%= link_to "Back to lists", lists_path, class: "btn btn-secondary mt-3" %>
</div>
<%= link_to "Delete Watchlist",
            list_path(@list),
            data: {
              turbo_method: :delete,
              turbo_confirm: "Are you sure?"
            },
            class: "btn btn-danger" %>
