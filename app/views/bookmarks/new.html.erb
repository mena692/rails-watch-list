<div class="container mt-4">
  <h1>Add a movie to <%= @list.name %></h1>

  <%= simple_form_for [@list, @bookmark] do |f| %>

  <%= f.association :movie,
                    collection: Movie.all,
                    label_method: :title,
                    value_method: :id %>
  <%= f.input :comment %>
  <%= f.submit "Add Movie", class: "btn btn-primary" %>

  <% end %>

  <%= link_to "Back", list_path(@list), class: "btn btn-secondary mt-3" %>
</div>
